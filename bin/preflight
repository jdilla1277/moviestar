#!/usr/bin/env bash
# Run the appropriate pre-push test suite based on what's changed.
#
# Some failures only appear in the slow suite, including Python-version
# annotation differences and incomplete bulk replacements in test arguments.
# This wrapper selects the fast or slow path based on what changed.
#
# Usage:
#   bin/preflight              # auto-pick based on `git diff` against origin/main
#   bin/preflight --docs       # public docs and distributed-skill contracts only
#   bin/preflight --slow       # force --run-slow regardless
#   bin/preflight --fast       # force fast path regardless
#
# Wire it into git as a pre-push hook with:
#   ln -s ../../bin/preflight .git/hooks/pre-push

set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$REPO_ROOT"

mode="${1:-auto}"

case "$mode" in
  --docs) suite=docs ;;
  --slow) suite=slow ;;
  --fast) suite=fast ;;
  auto)
    # Look at uncommitted + staged + ahead-of-main changes.
    base="$(git merge-base HEAD origin/main 2>/dev/null || git merge-base HEAD main 2>/dev/null || echo HEAD~1)"
    changed="$(git diff --name-only "$base"...HEAD ; git diff --name-only ; git diff --cached --name-only)"
    suite="$(printf '%s\n' "$changed" | python3 "$REPO_ROOT/bin/select-preflight-mode")"
    ;;
  *)
    echo "usage: bin/preflight [--docs|--slow|--fast]" >&2
    exit 2
    ;;
esac

case "$suite" in
  docs)
    echo "preflight: public docs/skill-only changes → focused contracts" >&2
    "$REPO_ROOT/app/.venv/bin/python" -m pytest \
      "$REPO_ROOT/app/tests/test_public_docs_and_skill.py" \
      "$REPO_ROOT/app/tests/test_release_plumbing.py" \
      -q
    ;;
  slow)
    echo "preflight: tests or transcription-touching code changed → --run-slow" >&2
    "$REPO_ROOT/bin/test" --run-slow
    ;;
  fast)
    echo "preflight: no tests or transcription-touching code changed → fast path" >&2
    "$REPO_ROOT/bin/test"
    ;;
esac

"$REPO_ROOT/app/.venv/bin/python" "$REPO_ROOT/bin/check-dependency-licenses"
